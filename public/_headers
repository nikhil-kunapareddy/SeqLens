# Static-host headers (Netlify/Cloudflare Pages syntax).
# SeqLens performs no network I/O after the initial page load, so the policy
# below blocks outbound connections entirely. This is the enforcement point for
# the "sequence data never leaves this browser" guarantee.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; object-src 'none'; manifest-src 'self'; form-action 'none'; frame-ancestors 'none'; base-uri 'none'
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), camera=(), microphone=(), usb=(), serial=(), bluetooth=(), payment=(), interest-cohort=()
