# Dependencies and build output
node_modules
dist
dist-ssr
coverage
*.tsbuildinfo
.vite
.eslintcache

# Local overrides and secrets. SeqLens needs none, so nothing like this belongs in git.
*.local
.env
.env.*
*.pem
*.key

# Sequence data. Test fixtures live in source as strings; real datasets stay on your machine.
*.fasta
*.fa
*.fna
*.faa
*.ffn
*.frn
*.fastq
*.fq
*.gz

# OS / editors
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Compiled TypeScript. The tsconfigs set noEmit, so these only appear if something runs
# tsc with emit enabled; the sources are the .ts/.tsx files beside them.
src/**/*.js
src/**/*.d.ts
vite.config.js
vitest.config.js
vite.config.d.ts
vitest.config.d.ts
