{
  "name": "seqlens",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "SeqLens — local-first sequence analysis workstation for FASTA/FASTQ. Runs entirely in the browser.",
  "license": "MIT",
  "author": "Sai Nikhil Kunapareddy",
  "homepage": "https://github.com/nikhil-kunapareddy/SeqLens#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nikhil-kunapareddy/SeqLens.git"
  },
  "bugs": {
    "url": "https://github.com/nikhil-kunapareddy/SeqLens/issues"
  },
  "keywords": [
    "bioinformatics",
    "fasta",
    "fastq",
    "sequence-analysis",
    "local-first",
    "privacy"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
